# ---------------------------------------------------------------------------
# Lexoria environment — copy to `.env` and adjust:  cp .env.example .env
# docker compose reads ./.env automatically for ${VAR} interpolation.
# .env is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- PostgreSQL (db service; production compose publishes NO host port) -----
POSTGRES_USER=lexoria
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=lexoria

# --- API database URL ------------------------------------------------------
# Used when the API / alembic run on the HOST against docker-compose.dev.yml
# (db published on 127.0.0.1:5432). The PRODUCTION compose ignores this value
# and derives the in-container URL from POSTGRES_* above (host `db`, no port
# mapping), so no edit is needed here for production.
# Scheme matches the app's synchronous SQLAlchemy driver (psycopg v3):
# postgresql+psycopg://. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://lexoria:change-me-strong-password@127.0.0.1:5432/lexoria

# --- API secrets / behavior -------------------------------------------------
# Generate one, e.g.  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-64-char-random-secret
# Comma-separated origins allowed (CORS + cookie auth). Keep in sync with the
# URL users actually open. HTTP default: http://localhost:8080 ;
# once HTTPS is enabled use https://<your-domain> instead.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# 'Secure' flag on auth cookies. MUST be true in production (HTTPS);
# must stay false while serving plain HTTP in development.
COOKIE_SECURE=false
# Lock registration once the instance is public.
ALLOW_REGISTRATION=true
# Directory INSIDE the api container where generated PDFs are stored.
# Keep aligned with the `pdfs` volume mount target in docker-compose.yml.
PDF_STORAGE_DIR=/data/pdfs

# --- web / nginx ------------------------------------------------------------
# Host ports mapped to the web container (80/443 inside the container).
HTTP_PORT=8080
HTTPS_PORT=8443
# nginx config file bind-mounted into the web container. Default = plain HTTP.
# To enable HTTPS point this at the example TLS config (see README "HTTPS"):
NGINX_CONF=./infra/nginx/nginx.conf
