{
  "name": "@lexoria/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hand-written thin typed HTTP client for the Lexiora API (/api/v1). Zero runtime deps. Regenerable from OpenAPI (see openapi/).",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "openapi"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate:openapi": "node openapi/generate.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
